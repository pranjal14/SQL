
1 - How to find duplicate records?
SELECT 
    user_id,
    COUNT(*) AS duplicate_count
FROM customer_data
GROUP BY user_id
HAVING COUNT(*) > 1;


2 - How to delete duplicate records?
DELETE FROM customer_data
WHERE user_id IN (
    SELECT user_id
    FROM customer_data
    GROUP BY user_id
    HAVING COUNT(*) > 1
);


3 - How to get sales data for the last 30 days?
SELECT *
FROM sales
WHERE sale_date >= CURRENT_DATE - INTERVAL '30 days';

4 - Write a query to find the second highest salary from a table
SELECT MAX(salary) AS second_highest_salary
FROM employees
WHERE salary < (SELECT MAX(salary) FROM employees);

SELECT DISTINCT salary
FROM employees
ORDER BY salary DESC
LIMIT 1 OFFSET 1;


5 - Write SQL Query to Display the First 3 Chars of FIRST_NAME from the Table.
SELECT SUBSTRING(FIRST_NAME, 1, 3) AS FIRST_3_CHARS
FROM table_name;

6 - Write SQL Query to Find the Position of Alphabet ‘a’ in the FIRST_NAME Column.
SELECT FIRST_NAME, INSTR(FIRST_NAME, 'a') 
FROM EMPLOYEE;

7 - Write SQL Query to Replace ‘a’ with ‘A’ in FIRST_NAME from the Table.
SELECT REPLACE(FIRST_NAME, 'a', 'A') AS FIRST_NAME
FROM TABLE_NAME;

8 - Write SQL Query to Fetch people Whose FIRST_NAME Ends with ‘h’ and Has 6 Letters.
SELECT *
FROM your_table
WHERE FIRST_NAME LIKE '_____h';

9 - Write SQL Query to Show Only Odd Rows from a Table.
SELECT *
FROM table_name
WHERE MOD(id, 2) = 1;

10 - Write SQL Query to Show Only Even Rows from a Table.
SELECT *
FROM employee
WHERE MOD(id, 2) = 0;

